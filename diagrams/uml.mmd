classDiagram
    class Owner {
        +str name
        +int available_minutes
        +str preferences
        +list~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() list
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task)
    }

    class Task {
        +str title
        +int duration
        +str priority
        +str time
        +str frequency
        +bool completed
        +edit(title, duration, priority)
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +str start_time
        +get_pending_tasks() list
        +generate_plan() dict
        +explain_plan(plan) str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
    Scheduler ..> Task : schedules
