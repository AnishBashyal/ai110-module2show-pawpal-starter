classDiagram
    class Owner {
        +str name
        +int available_minutes
        +str preferences
        +Pet pet
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task)
    }

    class Task {
        +str title
        +int duration
        +str priority
        +edit(title, duration, priority)
    }

    class Scheduler {
        +Owner owner
        +str start_time
        +generate_plan() dict
        +explain_plan() str
    }

    Owner "1" --> "1" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
    Scheduler ..> Task : schedules
